# ──────────────────────────────────────────────────────────────────────
# Reese Astor catalog — env vars consumed by the client + server.
# Copy to .env (local) or set in Vercel project settings (deploy).
# ──────────────────────────────────────────────────────────────────────

# ─── MailerLite ────────────────────────────────────────────────────────
# API key + group IDs for newsletter routing. Group IDs are MailerLite
# numeric IDs, not free-text tags — create the group in MailerLite first
# and paste its ID here.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=                  # default Reader's Club group

# /permission landing form sends new subscribers here so the launch
# sequence segmentation works. Create a "permission_landing" group in
# MailerLite and paste the ID. Surfaced to the client as VITE_*.
VITE_MAILERLITE_PERMISSION_GROUP_ID=

# ─── /permission retail channels ──────────────────────────────────────
# Each missing var causes the corresponding button to hide gracefully
# rather than render a dead link. See client/src/data/retailers.ts.
VITE_PERMISSION_GUMROAD_URL=
VITE_PERMISSION_AUDIBLE_URL=
VITE_PERMISSION_APPLE_URL=
VITE_PERMISSION_SPOTIFY_URL=
VITE_PERMISSION_ELEVENREADER_URL=
VITE_PERMISSION_GOOGLEPLAY_URL=
VITE_PERMISSION_BOOKFUNNEL_URL=
VITE_PERMISSION_AMAZON_URL=

# ─── Manus OAuth (optional) ────────────────────────────────────────────
# Only needed in environments running the Manus IDE flow. When unset,
# the in-app /auth/login route is used instead. See client/src/const.ts.
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# ─── Analytics (optional) ──────────────────────────────────────────────
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
