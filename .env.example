# ──────────────────────────────────────────────────────────────────────
# Reese Astor — env vars consumed by the client + server.
# Copy to .env (local) or set in Vercel project settings (deploy).
#
# Vars prefixed VITE_* are inlined into the client bundle at build time.
# Everything else is server-only.
# ──────────────────────────────────────────────────────────────────────

# ─── Authentication ───────────────────────────────────────────────────
# The site supports two parallel auth paths. At least one must be wired
# or sign-in is unavailable.

# (a) Supabase — email/password + OAuth (Google, GitHub, Facebook) +
#     magic link. Used by /auth/login. Server uses SUPABASE_URL +
#     SUPABASE_SERVICE_ROLE_KEY to sync sessions in /api/auth/callback.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# (b) Manus OAuth portal — used when the SPA is hosted inside the Manus
#     IDE flow. Optional in production. When unset, the auth page falls
#     back to Supabase. When BOTH are unset, /auth/login renders a
#     "sign-in not yet enabled" page instead of crashing.
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Session signing for the local-DB user sync after Supabase login. Also
# used by /api/cron/* routes as the Bearer secret.
JWT_SECRET=

# ─── MailerLite ───────────────────────────────────────────────────────
# Required for /newsletter, NewsletterBand, /free-book, /permission.
# Group IDs are MailerLite numeric IDs — create each group in MailerLite
# first and paste its ID here.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=                  # default Reader's Club group

# Lane-aligned segmentation. Per-title and /permission newsletter forms
# pick the correct group based on the book's lane.
VITE_MAILERLITE_MMK_GROUP_ID=
VITE_MAILERLITE_HUDSON_GROUP_ID=
VITE_MAILERLITE_INTIMATE_GROUP_ID=

# /permission landing form alias — falls back to INTIMATE_GROUP_ID.
VITE_MAILERLITE_PERMISSION_GROUP_ID=

# ─── /permission retail channels ──────────────────────────────────────
# Each missing var hides the corresponding button rather than rendering
# a dead link. See client/src/data/retailers.ts.
VITE_PERMISSION_GUMROAD_URL=
VITE_PERMISSION_AUDIBLE_URL=
VITE_PERMISSION_APPLE_URL=
VITE_PERMISSION_SPOTIFY_URL=
VITE_PERMISSION_ELEVENREADER_URL=
VITE_PERMISSION_GOOGLEPLAY_URL=
VITE_PERMISSION_BOOKFUNNEL_URL=
VITE_PERMISSION_AMAZON_URL=

# ─── Database ──────────────────────────────────────────────────────────
# MySQL via Drizzle ORM. AdminBooks CRUD reads/writes books here.
DATABASE_URL=

# ─── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# ─── Email (transactional, e.g. welcome email after newsletter signup) ─
RESEND_API_KEY=

# ─── Analytics (optional) ──────────────────────────────────────────────
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ─── External AI / integrations (optional) ─────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENAI_API_KEY=
ELEVENLABS_API_KEY=

# ─── Twilio (SMS, optional) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Vercel Deployment Protection ──────────────────────────────────────
# Not an env var — set in Vercel project settings:
#   Project → Settings → Deployment Protection
#   For production: "Only Preview Deployments" (so reeseastor.com is public)
#   For previews: keep Vercel SSO so unfinished work isn't public.

# ─── Canon archive ─────────────────────────────────────────────────────
# Store original manuscripts in a private object store. `canon_documents.storageKey`
# records the object key; indexed text and reader-visible excerpts live in PostgreSQL.
# Do not expose raw manuscript URLs in client-side VITE_* variables.
CANON_ARCHIVE_STORAGE=
