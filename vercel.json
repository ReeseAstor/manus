{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build && node scripts/prerender-static.mjs && node scripts/seal-admin-chunks.mjs && node scripts/bundle-server.mjs server/_core/vercel-app.ts dist/server-bundle.mjs",
  "outputDirectory": "dist/public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@5.1.10",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "0 13 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.reeseastor.com"
        }
      ],
      "destination": "https://reeseastor.com/$1",
      "permanent": true
    },
    {
      "source": "/blog/ai-assisted-romance-writing-workflow",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/ai-assisted-romance-writing-workflow/",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/romance-author-writing-tools-setup",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/romance-author-writing-tools-setup/",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/quality-control-workflows-romance-authors",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/quality-control-workflows-romance-authors/",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/ai-newsletter",
      "destination": "/newsletter",
      "permanent": true
    },
    {
      "source": "/ai-newsletter/",
      "destination": "/newsletter",
      "permanent": true
    },
    {
      "source": "/blog/self-publishing-journey",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/usa-today-bestselling-author-journey",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/day-in-the-life-romance-author",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/business-side-romance-writing",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/author-brand-social-media",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/email-list-building-authors",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/self-publishing-romance-amazon-kdp-beginners-guide",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/author-email-list-strategy-sell-books",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/books/audit-of-the-heart",
      "destination": "/books/the-first-acquisition",
      "permanent": true
    },
    {
      "source": "/books/poison-pills",
      "destination": "/books/poison-pill",
      "permanent": true
    },
    {
      "source": "/character-quiz",
      "destination": "/quiz",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/covers/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/assets/admin/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell"
    }
  ]
}
