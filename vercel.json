{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build && pnpm exec esbuild server/_core/vercel-app.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server-bundle.mjs",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@5.1.10",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/book2/countdown",
      "destination": "/books/the-billionaire-s-fake-wife",
      "permanent": false
    },
    {
      "source": "/book2/countdown/",
      "destination": "/books/the-billionaire-s-fake-wife",
      "permanent": false
    },
    {
      "source": "/book2/countdown/:path*",
      "destination": "/books/the-billionaire-s-fake-wife",
      "permanent": false
    },
    {
      "source": "/books/audit-of-the-heart",
      "destination": "/books",
      "permanent": false
    },
    {
      "source": "/books/audit-of-the-heart/",
      "destination": "/books",
      "permanent": false
    },
    {
      "source": "/promo",
      "destination": "/free-book",
      "permanent": false
    },
    {
      "source": "/promo/",
      "destination": "/free-book",
      "permanent": false
    }
  ]
}
