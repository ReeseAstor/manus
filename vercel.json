{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build && pnpm exec esbuild server/_core/vercel-app.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server-bundle.mjs",
  "outputDirectory": "dist/public",
  "redirects": [
    { "source": "/why-buy-direct", "destination": "/books", "permanent": true },
    { "source": "/why-buy-direct/", "destination": "/books", "permanent": true },
    { "source": "/permission", "destination": "/books", "permanent": true },
    { "source": "/permission/", "destination": "/books", "permanent": true }
  ],
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@5.1.10",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/webhooks/(.*)", "destination": "/api" },
    { "source": "/sitemap.xml", "destination": "/api" },
    { "source": "/robots.txt", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
